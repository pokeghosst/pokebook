{
	"name": "pokebook",
	"version": "3.3.0",
	"description": "The ultimate digital notebook for writing poetry.",
	"keywords": [
		"Poetry",
		"Writing",
		"Productivity",
		"Writing software"
	],
	"author": "Pokeghost",
	"license": "AGPL-3.0",
	"repository": {
		"type": "git",
		"url": "https://codeberg.org/pokesuite/pokebook"
	},
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"test": "vitest",
		"static": "cross-env ADAPTER=static vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"prepare": "husky"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/adapter-vercel": "^6.3.4",
		"@sveltejs/kit": "^2.70.2",
		"@sveltejs/vite-plugin-svelte": "6.2.1",
		"@types/node": "^26.1.2",
		"@typescript-eslint/eslint-plugin": "^8.65.0",
		"@typescript-eslint/parser": "^8.65.0",
		"cross-env": "^10.1.0",
		"dotenv": "^17.4.2",
		"eslint": "^10.8.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.22.0",
		"fake-indexeddb": "^6.2.5",
		"fast-check": "^4.9.0",
		"husky": "^9.1.7",
		"jsdom": "^30.0.1",
		"lint-staged": "^17.3.0",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"sass": "^1.77.8",
		"svelte": "^5.56.8",
		"svelte-check": "^4.7.4",
		"typescript": "^7.0.2",
		"typescript-eslint": "^8.65.0",
		"vite": "^7.3.6",
		"vite-plugin-devtools-json": "^1.1.0",
		"vitest": "^4.1.10"
	},
	"dependencies": {
		"@zip.js/zip.js": "^2.8.22",
		"fast-xml-parser": "^5.5.7",
		"hotkeys-js": "^3.13.7",
		"lucide-svelte": "^0.474.0",
		"svelte-5-french-toast": "^2.0.6",
		"svelte-modals": "^2.0.1",
		"sveltekit-i18n": "^2.4.2",
		"syllable": "^5.0.1"
	},
	"lint-staged": {
		"*": "prettier --ignore-unknown --write",
		"*.js": "eslint --fix"
	}
}
